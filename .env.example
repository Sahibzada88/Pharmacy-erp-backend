# Django
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# On Vercel, Django's ALLOWED_HOSTS natively accepts * as "allow any host" —
# fine for testing, but prefer your exact domain in production:
# ALLOWED_HOSTS=your-backend.vercel.app

# Supabase Postgres connection
# Get this from Supabase Project -> Settings -> Database -> Connection string (URI, use "Transaction pooler" for Railway/serverless)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project details (optional, used only if you later add supabase-py for storage/realtime)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# CORS - frontend URLs (Next.js on Vercel + local dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
# For quick testing only, CORS_ALLOWED_ORIGINS=* is also supported (turns on
# CORS_ALLOW_ALL_ORIGINS internally) — do not use this in production.

# JWT
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7
